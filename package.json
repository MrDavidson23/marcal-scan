{
  "name": "marcal-scan",
  "version": "0.1.1",
  "description": "Find exposed secrets and API keys in a GitHub repo or local folder, with a readable risk report, SARIF output, and a GitHub Action. Built on gitleaks.",
  "keywords": ["security", "secrets", "secret-scanning", "gitleaks", "sarif", "github-action", "devsecops"],
  "author": "Sebastián Quesada Calderón <squesadac@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/MrDavidson23/marcal-scan#readme",
  "repository": { "type": "git", "url": "git+https://github.com/MrDavidson23/marcal-scan.git" },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" } },
  "bin": { "marcal-scan": "dist/src/cli.js" },
  "files": ["dist/src", "config", "scripts", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "tar": "^7.5.22"
  },
  "peerDependencies": {
    "puppeteer": ">=22"
  },
  "peerDependenciesMeta": {
    "puppeteer": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0"
  }
}
